{
  "$doc": "Défaut optionnel « hébergement » (les apps envoient normalement LEURS règles par requête) — générique à tout site voyage exposant OpenGraph et/ou schema.org (Hotel, VacationRental, Product…). Chaque champ est une règle ou une CHAÎNE de règles : la première qui trouve gagne.",
  "name": [
    { "jsonld": "Hotel.name" },
    { "jsonld": "VacationRental.name" },
    { "jsonld": "LodgingBusiness.name" },
    { "jsonld": "Product.name" },
    { "meta": "og:title" }
  ],
  "description": [
    { "jsonld": "Hotel.description" },
    { "jsonld": "VacationRental.description" },
    { "meta": "og:description" }
  ],
  "city": [
    { "jsonld": "Hotel.address.addressLocality" },
    { "jsonld": "VacationRental.address.addressLocality" },
    { "jsonld": "LodgingBusiness.address.addressLocality" },
    { "jsonld": "*.address.addressLocality" }
  ],
  "country": [
    { "jsonld": "Hotel.address.addressCountry" },
    { "jsonld": "*.address.addressCountry" }
  ],
  "latitude": [{ "jsonld": "*.geo.latitude" }],
  "longitude": [{ "jsonld": "*.geo.longitude" }],
  "rating": [{ "jsonld": "*.aggregateRating.ratingValue" }],
  "reviewCount": [{ "jsonld": "*.aggregateRating.reviewCount" }],
  "mainImage": [
    { "meta": "og:image" },
    { "jsonld": "Hotel.image" },
    { "jsonld": "*.image" }
  ]
}
