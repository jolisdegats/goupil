    {
      "jsonld": "Hotel.name"
    },
    {
      "jsonld": "VacationRental.name"
    },
    {
      "jsonld": "LodgingBusiness.name"
    },
    {
      "jsonld": "Product.name"
    },
    {
      "meta": "og:title"
    },
    {
      "microdata": "name"
    }
  ],
  "description": [
    {
      "jsonld": "Hotel.description"
    },
    {
      "jsonld": "VacationRental.description"
    },
    {
      "meta": "og:description"
    },
    {
      "microdata": "description"
    }
  ],
  "city": [
    {
      "jsonld": "Hotel.address.addressLocality"
    },
    {
      "jsonld": "VacationRental.address.addressLocality"
    },
    {
      "jsonld": "LodgingBusiness.address.addressLocality"
