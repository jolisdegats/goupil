    },
    {
      "microdata": "longitude"
    }
  ],
  "rating": [
    {
      "jsonld": "*.aggregateRating.ratingValue"
    },
    {
      "microdata": "ratingValue"
    }
  ],
  "reviewCount": [
    {
      "jsonld": "*.aggregateRating.reviewCount"
    },
    {
      "microdata": "reviewCount"
    }
  ],
  "mainImage": [
